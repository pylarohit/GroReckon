<?xml version="1.0" encoding="utf-8"?>
<!-- activity_track_ride.xml — Mapbox Smooth Ride Tracking with Google Maps Draggable BottomSheet -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8ECF2"
    tools:context=".dashboard.TrackRideActivity">

    <!-- ══════════════════════════════════════════════════════════════
         1. FULLSCREEN HARDWARE-ACCELERATED MAPBOX GL JS VIEW
         ══════════════════════════════════════════════════════════════ -->
    <WebView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══════════════════════════════════════════════════════════════
         2. TOP FLOATING INTERACTION CONTAINER (CLEAN DEFAULT)
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="42dp"
        android:paddingBottom="8dp">

        <!-- ── Compact Default Header Row (Back + Search Bar + GNSS) ── -->
        <LinearLayout
            android:id="@+id/layout_top_bar_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button"
                android:elevation="6dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    app:tint="@color/dark_charcoal"
                    android:contentDescription="Back" />

            </FrameLayout>

            <!-- Sleek Compact Search Bar (Tap to open full Google Maps style planner) -->
            <LinearLayout
                android:id="@+id/card_compact_search"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_route_card"
                android:elevation="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_search_bar_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:text="Where to? Search destination..."
                    android:textColor="@color/gmap_text_secondary"
                    android:textSize="13.5sp"
                    android:singleLine="true" />

                <!-- Small GNSS Status Dot inside search bar -->
                <View
                    android:id="@+id/view_status_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/nav_green" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Expanded Route Planner Card (Hidden by Default, shows on demand) ── -->
        <LinearLayout
            android:id="@+id/card_route_planner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_route_card"
            android:elevation="10dp"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Card Header: Title + Close Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Set Route"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- Close / Collapse Planner Button -->
                <FrameLayout
                    android:id="@+id/btn_close_planner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✕"
                        android:textColor="@color/dark_charcoal"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- Row 1: Start Location (Origin) -->
            <LinearLayout
                android:id="@+id/layout_start_input_row"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F8FAFC"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/et_search_start"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@android:color/transparent"
                    android:hint="Your Location (GPS) or enter place..."
                    android:textColor="@color/gmap_text_primary"
                    android:textColorHint="@color/gmap_text_secondary"
                    android:textSize="13.5sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <!-- Clear Start / Reset to GPS -->
                <FrameLayout
                    android:id="@+id/btn_clear_start_text"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✕"
                        android:textColor="@color/medium_grey"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Submit Start Search -->
                <FrameLayout
                    android:id="@+id/btn_submit_start"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#0F9D58"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="➔"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- Row Divider with Swap Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

                <!-- Swap Start and Destination -->
                <FrameLayout
                    android:id="@+id/btn_swap_locations"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_button"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⇅"
                        android:textColor="@color/dark_charcoal"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E2E8F0" />

            </LinearLayout>

            <!-- Row 2: Destination Location (To) -->
            <LinearLayout
                android:id="@+id/layout_dest_input_row"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#F8FAFC"
                android:paddingStart="10dp"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏁"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_search_destination"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@android:color/transparent"
                    android:hint="Enter destination or place name..."
                    android:textColor="@color/gmap_text_primary"
                    android:textColorHint="@color/gmap_text_secondary"
                    android:textSize="13.5sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <!-- Clear Destination -->
                <FrameLayout
                    android:id="@+id/btn_clear_dest_text"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✕"
                        android:textColor="@color/medium_grey"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Submit Destination Search -->
                <FrameLayout
                    android:id="@+id/btn_submit_dest"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="@color/dark_charcoal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="➔"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

            </LinearLayout>

            <!-- Row 3: Double-Click Mode Selection Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <!-- Chip 1: Pick Destination on Map -->
                <LinearLayout
                    android:id="@+id/chip_pick_dest_map"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tv_chip_dest_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏁 Pick Dest (Double-Tap)"
                        android:textColor="@color/white"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Chip 2: Pick Start on Map -->
                <LinearLayout
                    android:id="@+id/chip_pick_start_map"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tv_chip_start_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 Pick Start (Double-Tap)"
                        android:textColor="@color/dark_charcoal"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Chip 3: Reset Start to GPS -->
                <LinearLayout
                    android:id="@+id/chip_reset_gps"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_inactive"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 GPS"
                        android:textColor="@color/dark_charcoal"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Mode Helper Hint Pill -->
            <TextView
                android:id="@+id/tv_selection_mode_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="💡 Double-click anywhere on the map to set Destination"
                android:textColor="@color/medium_grey"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         3. FLOATING ACTION CONTROLS STACK (RIGHT-SIDE)
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_floating_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="112dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Satellite / Street Toggle -->
        <FrameLayout
            android:id="@+id/btn_toggle_layer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_layer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🛰️"
                android:textSize="20sp" />

        </FrameLayout>

        <!-- 3D / 2D Perspective Toggle -->
        <FrameLayout
            android:id="@+id/btn_toggle_perspective"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_perspective_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="3D"
                android:textColor="@color/dark_charcoal"
                android:textSize="13sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Recenter on GPS -->
        <FrameLayout
            android:id="@+id/btn_recenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gps"
                app:tint="@color/dark_charcoal"
                android:contentDescription="Recenter" />

        </FrameLayout>

    </LinearLayout>

    <!-- ══════════════════════════════════════════════════════════════
         4. BOTTOM CONNECTED & DRAGGABLE SHEET (GOOGLE MAPS STYLE)
         ══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/card_ride_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet_gmap"
        android:elevation="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="95dp"
        app:behavior_hideable="false"
        app:behavior_fitToContents="true">

        <!-- Tappable Drag Handle Area (Expands or Collapses sheet) -->
        <FrameLayout
            android:id="@+id/layout_drag_handle_area"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="38dp"
                android:layout_height="4.5dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_handle" />

        </FrameLayout>

        <!-- Peek Header Row (Always visible when sheet is down ~68dp) -->
        <LinearLayout
            android:id="@+id/layout_dest_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_dest_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_dest_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Destination"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dest_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swipe up for ride details &amp; speedometer"
                    android:textColor="@color/medium_grey"
                    android:textSize="11.5sp" />

            </LinearLayout>

            <!-- Clear Destination Pin Button -->
            <FrameLayout
                android:id="@+id/btn_clear_dest"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_button"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="✕"
                    android:textColor="@color/medium_grey"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Chevron indicator showing it can be expanded/collapsed -->
            <TextView
                android:id="@+id/tv_sheet_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="▲"
                android:textColor="@color/medium_grey"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Scrollable Body (Revealed when dragged up) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_bottom_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">

                <!-- Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7"
                    android:layout_marginBottom="12dp" />

                <!-- Telemetry Metrics Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Metric 1: Speedometer -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <TextView
                                android:id="@+id/tv_ride_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/dark_charcoal"
                                android:textSize="38sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="km/h"
                                android:textColor="@color/medium_grey"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT SPEED"
                            android:textColor="@color/medium_grey"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                    </LinearLayout>

                    <!-- Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="#E2E8F0"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="16dp" />

                    <!-- Metric 2: Distance -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ride_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textColor="@color/dark_charcoal"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tv_distance_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="DISTANCE (KM)"
                            android:textColor="@color/medium_grey"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                    </LinearLayout>

                    <!-- Vertical Divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="#E2E8F0"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="16dp" />

                    <!-- Metric 3: Duration -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_ride_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/dark_charcoal"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/tv_time_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="DURATION"
                            android:textColor="@color/medium_grey"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EDF2F7"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp" />

                <!-- Prominent Start / Stop Action Button -->
                <LinearLayout
                    android:id="@+id/btn_ride_control"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_start_ride"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_ride_btn_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Set Destination"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                </LinearLayout>

                <!-- ── Additional Scrollable Information Section ──────── -->
                <LinearLayout
                    android:id="@+id/layout_extra_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EDF2F7"
                        android:layout_marginBottom="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAVIGATION &amp; ENGINE STATUS"
                        android:textColor="@color/medium_grey"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <!-- Badge 1: Routing details -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Shortest &amp; Best Road Route"
                                android:textColor="@color/dark_charcoal"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mapbox Directions v5 with dynamic traffic avoidance"
                                android:textColor="@color/medium_grey"
                                android:textSize="10.5sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Badge 2: Dead reckoning pipeline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F8FAFC"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧠"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KinoNet-R2 AI Dead Reckoning"
                                android:textColor="@color/dark_charcoal"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100 Hz IMU sensor fusion &amp; Extended Kalman Filter"
                                android:textColor="@color/medium_grey"
                                android:textSize="10.5sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Helpful tip -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="💡 Double-click anywhere on the map to place start or destination pins."
                        android:textColor="@color/medium_grey"
                        android:textSize="11sp"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
