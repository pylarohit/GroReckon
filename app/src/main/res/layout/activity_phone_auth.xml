<?xml version="1.0" encoding="utf-8"?>
<!--  activity_phone_auth.xml  —  Phone OTP login screen  -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- ── Top bar ──────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="@null"
            android:padding="12dp"
            android:contentDescription="Back" />

    </LinearLayout>

    <!-- ── Scrollable content ───────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="40dp">

            <!-- Title / Subtitle -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify Phone"
                android:textColor="@color/dark_charcoal"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="We'll send a one-time code to your number"
                android:textColor="@color/medium_grey"
                android:textSize="13sp" />

            <!-- ════ PHASE 1: Phone number ════ -->
            <LinearLayout
                android:id="@+id/section_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:layout_marginBottom="8dp"
                    android:text="PHONE NUMBER"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="+91 9876543210"
                    android:inputType="phone"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/dark_charcoal"
                    android:textColorHint="@color/medium_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Include country code, e.g. +91 for India"
                    android:textColor="@color/medium_grey"
                    android:textSize="11sp" />

                <Space android:layout_width="match_parent" android:layout_height="28dp" />

                <!-- Send OTP button -->
                <LinearLayout
                    android:id="@+id/btn_send_otp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_dark"
                    android:clickable="true"
                    android:focusable="true">

                    <ProgressBar
                        android:id="@+id/progress_send"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/white" />

                    <TextView
                        android:id="@+id/tv_btn_send_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Send OTP"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- ════ PHASE 2: OTP entry (hidden until SMS sent) ════ -->
            <LinearLayout
                android:id="@+id/section_otp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_phone_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/medium_grey"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"
                    android:text="ONE-TIME PASSWORD"
                    android:textColor="@color/dark_charcoal"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <!-- Large centred OTP field -->
                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="● ● ● ● ● ●"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:gravity="center"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.5"
                    android:textColor="@color/dark_charcoal"
                    android:textColorHint="@color/light_grey" />

                <Space android:layout_width="match_parent" android:layout_height="28dp" />

                <!-- Verify OTP button -->
                <LinearLayout
                    android:id="@+id/btn_verify_otp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_dark"
                    android:clickable="true"
                    android:focusable="true">

                    <ProgressBar
                        android:id="@+id/progress_verify"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:visibility="gone"
                        android:indeterminateTint="@color/white" />

                    <TextView
                        android:id="@+id/tv_btn_verify_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verify &amp; Sign In"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <Space android:layout_width="match_parent" android:layout_height="20dp" />

                <!-- Resend countdown -->
                <TextView
                    android:id="@+id/tv_resend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Resend OTP"
                    android:textColor="@color/green_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
